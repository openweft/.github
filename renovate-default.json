{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate config for the openweft org. Edit here to propagate to every repo on its next Renovate run. Each repo extends via: github>openweft/.github:renovate-default",
  "extends": ["config:recommended"],
  "schedule": ["before 5am on monday"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "packageRules": [
    {
      "description": "Group go module minor+patch bumps under one PR per week",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "go modules (minor + patch)"
    },
    {
      "description": "Major go module bumps : one PR per package, labeled for review",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Group github-actions bumps",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group dockerfile base-image bumps",
      "matchManagers": ["dockerfile"],
      "groupName": "dockerfile base images"
    },
    {
      "description": "Group npm minor+patch (frontend deps)",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm (minor + patch)"
    }
  ],
  "postUpdateOptions": ["gomodTidy"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "prHourlyLimit": 0,
    "prConcurrentLimit": 0
  }
}
